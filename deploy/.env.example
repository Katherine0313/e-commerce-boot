# 复制为 .env 后填真实值；.env 不要提交到版本库
# 所有服务通过 env_file 读取这一份，多余的变量会被忽略

SPRING_PROFILES_ACTIVE=prod
NACOS_ADDR=nacos:8848

# JWT：所有业务服务必须一致；建议 openssl rand -base64 48 生成
JWT_SECRET=请替换为至少64位随机字符串

# MySQL：宝塔宿主机用 host.docker.internal；远程库改成远程 IP
DB_URL="jdbc:mysql://host.docker.internal:3306/e_commerce_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
DB_USERNAME=e_commerce_db
DB_PASSWORD=请填写

# Python ai-service 直连 MySQL 只读查询商品（用户名/密码复用上面两项）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=e_commerce_db

# 微信小程序
WECHAT_APPID=wxa18a22c8c5c1fa12
WECHAT_SECRET=请填写
# 订阅消息环境：formal 正式版 / trial 体验版 / developer 开发版（本地测试用 developer）
# WECHAT_MINIPROGRAM_STATE=formal

# Python ai-service 知识库连接（与 Java 后端共用同一个库）
# 知识库表由 docs/sql/20261105_kb.sql 创建，导入脚本在 recommender-python/scripts/import_kb.py

# Redis：docker-compose 的 redis 服务，服务名直连，不走宿主机端口
REDIS_HOST=redis
REDIS_PORT=6379
# Redis 密码：redis 容器和后端服务共用这一个变量
SPRING_DATA_REDIS_PASSWORD=请填写

# 低配优化
SERVER_TOMCAT_THREADS_MAX=100
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRINGDOC_ENABLED=false
SQL_DEBUG=INFO

# ==================== 镜像仓库（腾讯云 TCR 个人版） ====================
# 填 TCR 控制台给的仓库地址 + 命名空间，例如 ccr.ccs.tencentyun.com/ecommerce
# 本地 deploy/release.sh 也会读取这个值（或直接用同名环境变量覆盖）
REGISTRY=ccr.ccs.tencentyun.com/your-namespace
# 镜像版本：deploy/release.sh 会自动传入；手动部署时改成具体版本
TAG=latest
