UPDATE `admin_menu` SET `parent_id`=0, `menu_name`='发货管理', `menu_type`='M',
    `path`='/delivery', `perms`=NULL, `icon`='SendOutlined', `sort_order`=4 WHERE `id`=201;
-- ② 顶级菜单顺延排序：售后5 营销6 会员7 系统8
