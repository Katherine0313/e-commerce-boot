<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ecommerce.user.mapper.UserMapper">
    <!-- user 是 MySQL 关键字，表名统一用反引号包裹 -->
    <!-- 注意：findByOpenid 故意【不加】is_deleted = 0 过滤——注销用户的 openid 仍占着 uk_openid 唯一键，
         若这里过滤掉，"查不到→重新 INSERT" 会撞唯一键报错；是否允许登录交给 Service 判 is_deleted -->
    <select id="findByOpenid" resultType="ecommerce.user.entity.User">
        SELECT *
        FROM `user`
        WHERE openid = #{openid}
    </select>
    <select id="findById" resultType="ecommerce.user.entity.User">
        SELECT *
        FROM `user`
        WHERE id = #{id}
    </select>
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user`(openid, name, phone, sex, avatar)
        VALUES(#{openid},#{name},#{phone},#{sex},#{avatar})
    </insert>
    <update id="updateAvatar">
        UPDATE `user` SET avatar = #{avatar}, update_time = NOW() WHERE id = #{id}
    </update>
    <update id="updateName">
        UPDATE `user` SET name = #{name}, update_time = NOW() WHERE id = #{id}
    </update>
    <update id="updatePhone">
        UPDATE `user` SET phone = #{phone}, update_time = NOW() WHERE id = #{id}
    </update>
    <!-- 软删除（注销）：置 is_deleted = 1；is_deleted = 0 保证重复注销不重复计数 -->
    <update id="softDelete">
        UPDATE `user` SET is_deleted = 1, update_time = NOW() WHERE id = #{id} AND is_deleted = 0
    </update>


</mapper>
