<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ecommerce.auth.mapper.AdminMapper">
    <select id="findByUsername" resultType="ecommerce.auth.entity.Admin">
        SELECT *
        FROM `admin`
        WHERE username = #{username}
    </select>
    <select id="findById" resultType="ecommerce.auth.entity.Admin">
        SELECT *
        FROM `admin`
        WHERE id = #{id}
    </select>
    <!-- 手机号未加唯一索引，取最早创建的一条，避免脏数据导致登录异常 -->
    <select id="findByPhone" resultType="ecommerce.auth.entity.Admin">
        SELECT *
        FROM `admin`
        WHERE phone = #{phone}
        ORDER BY id
        LIMIT 1
    </select>
</mapper>
