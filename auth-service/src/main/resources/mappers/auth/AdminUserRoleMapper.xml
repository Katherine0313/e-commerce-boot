<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ecommerce.auth.mapper.AdminUserRoleMapper">

    <select id="listRoleIds" resultType="long">
        SELECT role_id FROM admin_user_role WHERE admin_id = #{adminId} ORDER BY role_id
    </select>

    <delete id="deleteByAdminId">
        DELETE FROM admin_user_role WHERE admin_id = #{adminId}
    </delete>

    <insert id="insert">
        INSERT INTO admin_user_role (admin_id, role_id) VALUES (#{adminId}, #{roleId})
    </insert>

    <select id="countByRoleId" resultType="long">
        SELECT COUNT(*) FROM admin_user_role WHERE role_id = #{roleId}
    </select>

</mapper>
